pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- clon de frogger (2019)
-- electronica villacorta
function _init()
rana={}
car={}
cueva={}
tronco={}
offset=0.06
duracion_shake=0
shake=false
water_x=-8
water_di="ri"
water_timer=10
tronco_timer=0
puntos=0
vidas=3
modo="splash"
effect_timer=0
effect_pal=0
voltear=false
rotar=false
saltos=2
end

function _update60()
	if modo=="game" then
		if rana.estado=="saltando" then 
			teclado()
			animate_tronco()
			animate_car()
			animate_water()
			animate_contador()
			animate_salto()
			colision_t()
			colision_car()
			colision_agua()
			colision_cueva()
		elseif rana.estado=="ahogada" then
			animate_ahogado()
		elseif rana.estado=="muerta" then
			animate_muerto()
		end

	elseif modo=="splash" then
		teclado()
	elseif modo=="dead" then
		nueva_rana()
		vidas-=1
		if vidas<0 then 
			sfx(6) 
			modo="gameover"
		else
			modo="game"
		end
	elseif modo=="gameover" then
	elseif modo=="reset" then
		crear_cuevas()
		crear_troncos()
		crear_carros()
		nueva_rana()
		modo="game"
		music(0)
	end
end

function _draw()
	cls()
	if modo=="game" then
		draw_all()
	elseif modo=="splash" then
		draw_splash()
	elseif modo=="gameover" then
		draw_gameover()
	elseif modo=="reset" then
	end
	draw_debug()
--	flip()
end

function draw_all()
	draw_meta()
	draw_water()
	draw_tronco()
	draw_car()
	digito(puntos)
	draw_vidas()
	draw_contador()
	 -- for y=0,127,8 do
	 -- for x=0,127,8 do
	 -- rect(x,y,x+8,y+8,1)
	 -- end
	 -- end
	draw_rana()
	
end

function nueva_rana()
saltos=2
rana.direccion="up"
rana.estado="saltando"
rana.montada=0
rana.pic=32
rana.x=60
rana.y=112
rana.h=8
rana.anim_time=0
rana.anim_wait=.2
segundos=1800
end

function nuevo_tronco(largo,cantidad,linea,tipo,velocidad,timer2)
	y=16+(linea*8)	x=0
	--espaciado=(flr((16-(largo*(cantidad)))/cantidad))
	espaciado=((128-(largo*cantidad*8))/(cantidad))+4
	for j=1,cantidad do
	-- trocos
		if tipo=="troncos" then
			add(tronco,{x=x,y=y,timer=0,anim=velocidad,dx=1,size=1,tipo=1,time2=0,pic=38})
				for i=1,largo-1 do
					add(tronco,{x=x+(i*8),y=y,timer=0,anim=velocidad,dx=1,size=1,tipo=2,time2=0,pic=38})
				end
			add(tronco,{x=x+(largo*8),y=y,timer=0,anim=velocidad,dx=1,size=1,tipo=3,time2=0,pic=38})
		-- tortugas
		elseif tipo=="tortugas" then
			for i=1,largo do
				add(tronco,{x=x+(i*8),y=y,timer=0,anim=velocidad,dx=1,size=1,tipo=4,time2=timer2,pic=38})
			end
		end
		x=((largo*j)*8)+(espaciado*j)
	end
end

function crear_troncos()
	tronco=nil
	tronco={}
	nuevo_tronco(3,3,1,"troncos",10)
	nuevo_tronco(2,4,2,"tortugas",8,241)
	nuevo_tronco(5,2,3,"troncos",2)
	nuevo_tronco(3,3,4,"troncos",4)
	nuevo_tronco(3,3,5,"tortugas",3,0)
end

function crear_carros()
	car=nil
	car={}
	add(car,{x=0,y=72,timer=0,anim=4 ,dx=1,size=2,tipo=1})      --camion
	add(car,{x=32,y=72,timer=0,anim=4 ,dx=1,size=2,tipo=1})      --camion
	add(car,{x=64,y=72,timer=0,anim=4 ,dx=1,size=2,tipo=1})      --camion

	add(car,{x=-24,y= 80,timer=0,anim=1 ,dx=1,size=1.5,tipo=2}) --moto

	add(car,{x=136,y= 88,timer=0,anim=3 ,dx=1,size=1,tipo=3})   --carro

	add(car,{x=0,y= 96,timer=0,anim=3 ,dx=1,size=1,tipo=4})   --carro
	add(car,{x=64,y= 96,timer=0,anim=3 ,dx=1,size=1,tipo=4})   --carro

	add(car,{x=0,y=104,timer=0,anim=2 ,dx=1,size=1,tipo=5})     --carro
	add(car,{x=32,y=104,timer=0,anim=2 ,dx=1,size=1,tipo=5})    --carro
	add(car,{x=64,y=104,timer=0,anim=2 ,dx=1,size=1,tipo=5})    --carro
end

function crear_cuevas()
cueva=nil
cueva={}
add(cueva,{x=  8,rana=false,mosca=0,peligro=0})
add(cueva,{x= 32,rana=false,mosca=0,peligro=0})
add(cueva,{x= 56,rana=false,mosca=0,peligro=0})
add(cueva,{x= 80,rana=false,mosca=0,peligro=0})
add(cueva,{x=104,rana=false,mosca=0,peligro=0})
end

function draw_splash()
cls(12)
	for i=0,6 do
		map(0,6,0,i*8,16,1) --arena
	end
	map(16,0,16,16,16,4) --nombre
	print( "electronica villacorta",18,60,6)
	print( "2019",55,68,6)
	print("presione —",40,102,7)
end

function draw_death()
	palt(13,true)
	palt(0,false)
	map(32,0,20,20,4,4)
	rectfill(6,50,65,66,0)	
	rectfill(6,68,65,70,0)	
	rectfill(6,72,65,73,0)	
	rectfill(6,76,65,76,0)	
	pal()
	print("game over",20,56,10)
end

function draw_gameover()
	digito(puntos)
	rectfill(0,50,127,66,8)	
	rectfill(0,68,127,70,8)	
	rectfill(0,72,127,73,8)	
	rectfill(0,76,127,76,8)	
	print("game over",48,56,10)
end

function draw_nuevonivel()
	palt(13,true)
	palt(0,false)
	map(36,0,24,20,4,4)
	rectfill(6,50,65,66,0)	
	rectfill(6,68,65,70,0)	
	rectfill(6,72,65,73,0)	
	rectfill(6,76,65,76,0)	
	pal()
	print("nivel: "..nivel,20,56,10)
end

function draw_debug()
	if debug then
		print (debug,100,0,7)
	end
end

function draw_meta()
	map(0,4,0,8,16,2) --meta
	map(0,3,0,112,16,1) --inicio
	map(0,6,0,64,16,1) --arena
	for y=1,4 do
	map(0,1,0,72+(y*8),16,1) --carretera	
	end
	for i=1,5 do
	if cueva[i].rana then spr(28,cueva[i].x,16,2,1) end
	end
end

function draw_water()
x=water_x
	map(0,7,water_x,3*8,18,1)
	map(0,7,-8+x*-1,4*8,18,1)
	map(0,7,water_x,5*8,18,1)
	map(0,7,-8+x*-1,6*8,18,1)
	map(0,7,water_x,7*8,18,1)
end

function draw_tronco()
local i=0
tronco_timer+=1
-- intercambia pic de tortugas
a=0
if tronco_timer<19 then a=1
elseif tronco_timer>20 then a=0 end

if tronco_timer>80 then tronco_timer=0 end
	for t in all(tronco) do
	i+=1
		if tronco[i].tipo==1 then     -- inicio tronco
			spr(6,tronco[i].x,tronco[i].y)
		elseif tronco[i].tipo==2 then -- medio tronco
			spr(7,tronco[i].x,tronco[i].y)
		elseif tronco[i].tipo==3 then -- final tronco
			spr(8,tronco[i].x,tronco[i].y)
		elseif tronco[i].tipo==4 then -- tortuga
			spr(tronco[i].pic+a,tronco[i].x,tronco[i].y)
		end
		--rect(tronco[i].x,tronco[i].y,tronco[i].x+((tronco[i].size)*8),tronco[i].y+7,7)
	end
end

function draw_car()
local i,z
i=0
for t in all(car) do
	i+=1
	if car[i].tipo==1 then
		carro=21
		spr(22,car[i].x+8,car[i].y)
	elseif car[i].tipo==2 then
	    carro=23
		spr(24,car[i].x+8,car[i].y)
	elseif car[i].tipo==3 then
		carro=25
	elseif car[i].tipo==4 then
		carro=26
	elseif car[i].tipo==5 then
		carro=27
	end
	spr(carro,car[i].x,car[i].y)
	--rect(car[i].x,car[i].y,car[i].x+(car[i].size*7),car[i].y+7,7)
end
end

function draw_rana()
	a=rana.pic cy=0 cx=0 f=false r=false
	if rana.direccion=="up" then
		r=false b=a+16 cy=8 cx=0
	elseif rana.direccion=="do" then
		r=true b=a+16 cy=-8 cx=0
	elseif rana.direccion=="le" then
		f=false a+=2 b=a+16 cx=8 cy=0
	elseif rana.direccion=="ri" then
		f=true a+=2 b=a+16 cx=-8 cy=0
	end
	if rana.estado=="saltando" then
		spr(b, rana.x+cx, rana.y+cy,1,1,f,r)
	else
		a=rana.pic
	end
	spr(a, rana.x, rana.y,1,1,f,r)
 end

function draw_vidas()
	for i=0,vidas-1 do
		spr(5,0 + (i*7),121)
	end
end

function draw_contador()
t=flr(segundos/60)
rectfill(97,121,97+30,125,14)
	for i=0,t do
		rectfill(97,121,97+t,125,8)
		print(t,97,121,7)
	end
end

function colision_t()
	i=0 
	w=7
	for t in all(tronco) do
	i+=1 
	rana.montada=false
		if tronco[i].x+(tronco[i].size*w)>=rana.x and tronco[i].x<rana.x+w and tronco[i].y+w>=rana.y and tronco[i].y<rana.y+w then
		    rana.montada=true
			break
		end
	end
end

function colision_tronco(i)
	local w=7
	for t in all(tronco) do
		if tronco[i].x+(tronco[i].size*w)>=rana.x and tronco[i].x<rana.x+w and tronco[i].y+w>=rana.y and tronco[i].y<rana.y+w then
			return true	
		end
	end
end

function colision_agua()
	if rana.y>=24 and rana.y<=56 and rana.montada==false then
		rana.estado="ahogada"
		rana.pic=1
	end
end

function colision_car()
	i=0 a=0 w=7
	for t in all(car) do
	i+=1
		 if car[i].x+(car[i].size*w)>=rana.x and car[i].x<rana.x+w and car[i].y+w>=rana.y and car[i].y<rana.y+w then		
			rana.estado="muerta"
			rana.pic=0
			break
		end
	end
end

function colision_cueva()
	a=0
	for i=1,5 do
		if rana.x>=cueva[i].x and rana.x<=cueva[i].x+16 and rana.y<=16 and cueva[i].rana==false then
			cueva[i].rana=true
			nueva_rana()
			puntos+=50
			t=flr(segundos/60)*10
			puntos+=t
			sfx(4)
		end
		if cueva[i].rana==true then a+=1 end
	end
	if a==5 then 
		sfx(0) puntos+=1000 a=0
		for j=1,5 do
		cueva[j].rana=false
		end
	end
end

function animate_water()
	water_timer+=1
	if water_timer>=10 then 
		water_timer=0
		if water_x==0 then water_di="le" end
		if water_x==-4 then water_di="ri" end
		if water_di=="ri" then water_x+=1 end
		if water_di=="le" then water_x-=1 end
	end
end

function animate_contador()
segundos-=1
if segundos==60 then segundos=60 end
end

function animate_tronco()
	local i
		ar=10 ab=2 su=2 i=0
	for p in all(tronco) do -- animar tortugas
		i+=1
		if tronco[i].tipo==4 then
		tronco[i].time2+=1
		if tronco[i].time2>(ar+su+ab+su)*60 then tronco[i].time2=0 end
				if tronco[i].time2>=0 and tronco[i].time2<=ab*60 then
					tronco[i].pic=38 --abajo
				elseif tronco[i].time2>ab*60 and tronco[i].time2<=(ab+su)*60 then
					tronco[i].pic=40 --subiendo
				elseif tronco[i].time2>(ab+su)*60 and tronco[i].time2<=(ab+su+ar)*60 then 
					tronco[i].pic=36 --arriba
				elseif tronco[i].time2>(ab+su+ar)*60 and tronco[i].time2<=(ab+su+ar+su)*60 then
					tronco[i].pic=40 --subiendo
				end
		end
	end
	i=0
	for t in all(tronco) do --desplazamiento de troncos y tortugas
		i+=1
		tronco[i].timer+=tronco[i].dx
		if tronco[i].timer>=tronco[i].anim then
			tronco[i].timer=0
			if tronco[i].tipo>=1 and tronco[i].tipo<=3 then
				tronco[i].x+=1
				if tronco[i].x>=127 then tronco[i].x=-8 end
				if colision_tronco(i) then --mueve la rana sobre el tronco
					rana.x+=1 rana.montada=true
					if rana.x>=127 then rana.x=-8 end --loop
				end 
			elseif tronco[i].tipo==4 then 
				tronco[i].x-=1
			    if tronco[i].x<=-8 then tronco[i].x=127 end
				if colision_tronco(i) then  --mueve la rana sobre el tronco
					rana.x-=1  rana.montada=true
					if rana.x<=-8 then rana.x=127 end --loop
				end
			end
		end
	end
end

function animate_salto()
	if saltos==0 then rana.pic=32 end
	if saltos<2 then
		rana.anim_time+=1
		if rana.anim_time > 4 then
			rana.anim_time=0
			saltos+=1
			if saltos>2 then saltos=2 end
			if saltos==1 then 
			if rana.direccion=="up" then
			  rana.y-=8
			  puntos+=10
			elseif rana.direccion=="do" then
			  rana.y+=8
			elseif rana.direccion=="le" then
			  rana.x-=8
			elseif rana.direccion=="ri" then
			  rana.x+=8
			elseif rana.direccion=="" then
			end
			end
			if rana.y <= 0 then rana.y=0 end
			if rana.y >= 120 then rana.y=120 end
			if rana.x <= 0 then rana.x=0 end
			if rana.x >= 120 then rana.x=120 end
			rana.pic+=1
			if rana.pic > 33 then rana.pic=32 end
		end
	end
 end

function animate_muerto()
	rana.anim_time+=1
	if rana.anim_time<10 then screen_shake() end
	if rana.anim_time==1 then sfx(5) end
	-- if rana.anim_time<20 then rana.pic=1
	-- elseif rana.anim_time>=20 and rana.anim_time<40 then rana.pic=2
	if rana.anim_time>40 then modo="dead" rana.anim_time=41 end
 end

function animate_ahogado()
	rana.anim_time+=1
	if rana.anim_time<10 then screen_shake() end
	if rana.anim_time==1 then sfx(5) end
	if rana.anim_time<20 then rana.pic=1
	elseif rana.anim_time>=20 and rana.anim_time<40 then rana.pic=2
	elseif rana.anim_time>40 then modo="dead" rana.anim_time=41 end
 end

function animate_car()
	local i
	i=0
	for t in all(car) do
		i+=1
		car[i].timer+=car[i].dx
		if car[i].timer>=car[i].anim then
			car[i].timer=0
			if car[i].tipo==1 or car[i].tipo==3 or car[i].tipo==5 then
				car[i].x-=1
				if car[i].x<=-8 then car[i].x=128+(car[i].size*8)	end
			elseif car[i].tipo==2 or car[i].tipo==4 then 
				car[i].x+=1
				if car[i].x>=136 then car[i].x=-8	end
			end
		end
	end
end

function teclado()
	if modo=="game" then
	if btnp(0) then saltos=0 rana.direccion="le" sfx(2) end --up
	if btnp(1) then saltos=0 rana.direccion="ri" sfx(2) end --up
	if btnp(2) then
			saltos=0 rana.direccion="up" sfx(2)
			a=0
			for i=1,5 do --colision con paredes de cuevas
				if rana.x>=a and rana.x<=a+8 and rana.y<=24 then
					rana.y=24
				end
				a+=24
			end
			for i=1,5 do
			if rana.x>=cueva[i].x and rana.x<=cueva[i].x+16 and rana.y<=16 and cueva[i].rana==true then
				rana.y=24 --colision con cuevas ocupadas
			end
			end
		end
		if btnp(3) then
			saltos=0 rana.direccion="do" sfx(2)
		end
	end
	if btnp(5) then
		if modo=="splash" then 
			modo="reset"
		end
	end
end

function screen_shake()
	local fade=0.95
	local offset_x=16-rnd(32)
	local offset_y=16-rnd(32)
	offset_x*=offset
	offset_y*=offset	
	camera(offset_x,offset_y)
	offset*=fade
	if offset<0.05 then
		offset=0
	end
	duracion_shake+=1
	if duracion_shake>=5 then 
		shake=false 
		offset=0.06
		duracion_shake=0 
		camera(0,0) 
	end
end

function digito(n)
m="000000"
j=m..n
v=sub(j,#j-(#m-1),#j)
for d=1,#v do
n=0+sub(v,d,d)
spr(64+n+(n*1),0+((d-1)*15),0)
spr(65+n+(n*1),0+8+((d-1)*15),0)
end
end
